<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="application.cashierscreens.ChairController" alignment="CENTER" spacing="20">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label fx:id="titleLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <GridPane fx:id="seatGrid" hgap="5" vgap="5" alignment="CENTER"/>

    <HBox spacing="10" alignment="CENTER">
        <Button text="Proceed" fx:id="confirmButton" onAction="#proceed"/>
        <Button text="Back" onAction="#goBack"/>
        <Button text="Logout" fx:id="logoutButton" onAction="#logout" style="-fx-background-color: red; -fx-text-fill: white;"/>
    </HBox>
</VBox>
