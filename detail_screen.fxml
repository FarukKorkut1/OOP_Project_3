<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>


<VBox xmlns:fx="http://javafx.com/fxml"
	fx:controller="application.cashierscreens.DetailController"
	alignment="CENTER" spacing="20">
	<padding>
		<Insets top="20" right="20" bottom="20" left="20" />
	</padding>
	<ImageView fx:id="posterImageView" fitHeight="200"
		fitWidth="150" preserveRatio="true" />


	<Label fx:id="titleLabel"
		style="-fx-font-size: 24px; -fx-font-weight: bold;" />

	<GridPane hgap="10" vgap="10" alignment="CENTER">
		<Label text="Select Day:" GridPane.rowIndex="0"
			GridPane.columnIndex="0" />
		<ComboBox fx:id="dayComboBox" GridPane.rowIndex="0"
			GridPane.columnIndex="1" />

		<Label text="Select Session:" GridPane.rowIndex="1"
			GridPane.columnIndex="0" />
		<ComboBox fx:id="sessionComboBox" GridPane.rowIndex="1"
			GridPane.columnIndex="1" />

		<Label text="Select Hall:" GridPane.rowIndex="2"
			GridPane.columnIndex="0" />
		<ComboBox fx:id="hallComboBox" GridPane.rowIndex="2"
			GridPane.columnIndex="1" />

	</GridPane>

	<HBox spacing="10" alignment="CENTER">
		<Button text="Confirm" fx:id="confirmButton"
			onAction="#confirm" />
		<Button text="Cancel" fx:id="cancelButton" onAction="#cancel" />
		<Button text="Logout" fx:id="logoutButton" onAction="#logout"
			style="-fx-background-color: red; -fx-text-fill: white;" />
	</HBox>
</VBox>
