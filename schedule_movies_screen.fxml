<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="application_adminscreens.ScheduleMoviesController"
      alignment="CENTER" spacing="20">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Başlık -->
    <Label text="Schedule Movies" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <!-- GridPane İçeriği -->
    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <padding>
            <Insets top="10" right="10" bottom="10" left="10"/>
        </padding>

        <!-- Film Seçimi -->
        <Label text="Select Movie:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="movieComboBox" promptText="Select a movie" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <!-- Salon Seçimi -->
        <Label text="Select Hall:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="hallComboBox" promptText="Select a hall" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- Tarih Seçimi -->
        <Label text="Select Date:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="datePicker" promptText="Select a date" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <!-- Seans Seçimi -->
        <Label text="Select Session:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="sessionComboBox" promptText="Select a session" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <!-- Seans Ekleme Butonu -->
        <Button text="Add to Schedule" fx:id="addScheduleButton" onAction="#addSchedule" GridPane.rowIndex="4" GridPane.columnIndex="0" GridPane.columnSpan="2" alignment="CENTER"/>
    </GridPane>

    <!-- Mevcut Takvim -->
    <Label text="Current Schedule:" style="-fx-font-size: 18px;"/>
    <TableView fx:id="scheduleTable" prefHeight="300" prefWidth="600">
        <columns>
            <TableColumn text="Movie" fx:id="movieColumn"/>
            <TableColumn text="Hall" fx:id="hallColumn"/>
            <TableColumn text="Date" fx:id="dateColumn"/>
            <TableColumn text="Session" fx:id="sessionColumn"/>
        </columns>
    </TableView>

    <!-- Navigasyon Butonları -->
    <HBox alignment="CENTER" spacing="20">
        <Button text="Back" fx:id="backButton" onAction="#goBack"/>
        <Button text="Logout" fx:id="logoutButton" onAction="#logout" style="-fx-background-color: red; -fx-text-fill: white;"/>
    </HBox>
</VBox>
