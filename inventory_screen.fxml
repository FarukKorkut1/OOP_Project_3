<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml"
      fx:controller="application.managerscreens.InventoryController" alignment="CENTER" spacing="20">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Header -->
    <Label text="Product Inventory Management" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <!-- Table View -->
    <TableView fx:id="inventoryTable" prefHeight="300" prefWidth="600">
        <columns>
            <TableColumn fx:id="productColumn" text="Product Name" prefWidth="200"/>
            <TableColumn fx:id="stockColumn" text="Stock Quantity" prefWidth="150"/>
            <TableColumn fx:id="priceColumn" text="Price" prefWidth="150"/>
        </columns>
    </TableView>

    <!-- Input Section -->
    <GridPane hgap="10" vgap="10" alignment="CENTER">
        <Label text="Product:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="productComboBox" promptText="Select Product" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="New Stock Quantity:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="newStockField" promptText="Enter new stock quantity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="New Price:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="newPriceField" promptText="Enter new price" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <HBox spacing="10" alignment="CENTER" GridPane.rowIndex="3" GridPane.columnIndex="0" GridPane.columnSpan="2">
            <Button text="Update Stock" onAction="#updateStock"/>
            <Button text="Update Price" onAction="#updatePrice"/>
        </HBox>
    </GridPane>

    <!-- Navigation Buttons -->
    <HBox spacing="20" alignment="CENTER">
        <Button text="Back" onAction="#goBack"/>
        <Button text="Logout" onAction="#logout" style="-fx-background-color: red; -fx-text-fill: white;"/>
    </HBox>
</VBox>
